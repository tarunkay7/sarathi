DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
OPENAI_API_KEY=sk-...

# Razorpay TEST-MODE credentials only. Never put live-mode keys here or in .env
# on this prototype. All three are required: without the webhook secret the
# server refuses to take payments, because every delivery would fail signature
# verification and no payment could ever be confirmed.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
